# Copie este arquivo para ".env" (nunca commite o ".env" de verdade).
#
# Connection string do seu projeto Neon:
# painel do Neon -> Connection Details -> "Connection string" (formato psql)
# Exemplo: postgresql://usuario:senha@ep-xxxxx.regiao.aws.neon.tech/nome_do_banco?sslmode=require
DATABASE_URL=

# Schema onde as tabelas do Acervo DS vivem (scripts/aplicar_migrations.py cria se não existir)
DB_SCHEMA=acervo

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
